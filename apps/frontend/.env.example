# Copie para .env.local e ajuste se precisar.

# true = usa os dados de src/mocks (não precisa da API rodando)
# false = chama a API em VITE_API_URL
# Sem esta linha: mock ligado no `npm run dev` e DESLIGADO no `npm run build`.
VITE_USAR_MOCK=true

# Endereço da API (backend). Padrão: http://localhost:3333
VITE_API_URL=http://localhost:3333
