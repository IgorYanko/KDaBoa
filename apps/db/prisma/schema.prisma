generator client {
  provider = "prisma-client"
  output   = "../../backend/src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String   @db.VarChar(100)
  email           String   @unique @db.VarChar(150)
  senhaHash       String   @map("senha_hash") @db.VarChar(255)
  dataNascimento  DateTime @map("data_nascimento") @db.Date
  fotoUrl         String?  @map("foto_url") @db.VarChar(255)
  mostrarPresenca Boolean  @default(true) @map("mostrar_presenca")
  lembretesEmail  Boolean  @default(true) @map("lembretes_email")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamp(6)

  tokens          TokenRedefinicaoSenha[]
  eventosCriados  Evento[]                @relation("EventoCriador")
  interesses      UsuarioInteresse[]
  presencas       Presenca[]
  seguindo        Seguidor[]              @relation("Seguidor")
  seguidores      Seguidor[]              @relation("Seguido")
  bloqueiosFeitos Bloqueio[]              @relation("Bloqueador")
  bloqueadoPor    Bloqueio[]              @relation("Bloqueado")
  mensagens       Mensagem[]
  denuncias       Denuncia[]

  @@map("usuarios")
}

model TokenRedefinicaoSenha {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime  @map("expira_em") @db.Timestamp(6)
  usadoEm   DateTime? @map("usado_em") @db.Timestamp(6)
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "idx_tokens_usuario")
  @@map("tokens_redefinicao_senha")
}

model Categoria {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(60)

  eventos    Evento[]
  interesses UsuarioInteresse[]

  @@map("categorias")
}

model Local {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  cep       String?  @db.VarChar(9)
  endereco  String   @db.VarChar(200)
  bairro    String?  @db.VarChar(80)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  eventos Evento[]

  @@map("locais")
}

model Evento {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo              String    @db.VarChar(150)
  descricao           String?
  dataInicio          DateTime  @map("data_inicio") @db.Timestamp(6)
  dataFim             DateTime? @map("data_fim") @db.Timestamp(6)
  preco               Decimal   @default(0) @db.Decimal(8, 2)
  classificacaoEtaria Int       @default(0) @map("classificacao_etaria") @db.SmallInt
  imagemUrl           String?   @map("imagem_url") @db.VarChar(255)
  latitude            Decimal?  @db.Decimal(9, 6)
  longitude           Decimal?  @db.Decimal(9, 6)
  categoriaId         Int       @map("categoria_id")
  localId             Int       @map("local_id")
  criadorId           String    @map("criador_id") @db.Uuid
  criadoEm            DateTime  @default(now()) @map("criado_em") @db.Timestamp(6)

  categoria Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  local     Local      @relation(fields: [localId], references: [id], onDelete: Restrict)
  criador   Usuario    @relation("EventoCriador", fields: [criadorId], references: [id], onDelete: NoAction)
  presencas Presenca[]
  mensagens Mensagem[]

  @@index([dataInicio], map: "idx_eventos_data_inicio")
  @@index([categoriaId], map: "idx_eventos_categoria")
  @@map("eventos")
}

model UsuarioInteresse {
  usuarioId   String @map("usuario_id") @db.Uuid
  categoriaId Int    @map("categoria_id")

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, categoriaId])
  @@map("usuario_interesses")
}

model Presenca {
  usuarioId         String    @map("usuario_id") @db.Uuid
  eventoId          String    @map("evento_id") @db.Uuid
  confirmadoEm      DateTime  @default(now()) @map("confirmado_em") @db.Timestamp(6)
  lembreteEnviadoEm DateTime? @map("lembrete_enviado_em") @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, eventoId])
  @@index([eventoId], map: "idx_presencas_evento")
  @@map("presencas")
}

model Seguidor {
  seguidorId String   @map("seguidor_id") @db.Uuid
  seguidoId  String   @map("seguido_id") @db.Uuid
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamp(6)

  seguidor Usuario @relation("Seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("Seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@id([seguidorId, seguidoId])
  @@index([seguidoId], map: "idx_seguidores_seguido")
  @@map("seguidores")
}

model Bloqueio {
  bloqueadorId String   @map("bloqueador_id") @db.Uuid
  bloqueadoId  String   @map("bloqueado_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamp(6)

  bloqueador Usuario @relation("Bloqueador", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueado  Usuario @relation("Bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)

  @@id([bloqueadorId, bloqueadoId])
  @@map("bloqueios")
}

model Mensagem {
  id        BigInt   @id @default(autoincrement())
  eventoId  String   @map("evento_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  conteudo  String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamp(6)

  evento    Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  denuncias Denuncia[]

  @@index([eventoId, criadoEm], map: "idx_mensagens_evento_data")
  @@map("mensagens")
}

model Denuncia {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mensagemId    BigInt   @map("mensagem_id")
  denuncianteId String   @map("denunciante_id") @db.Uuid
  motivo        String   @db.VarChar(255)
  status        String   @default("pendente") @db.VarChar(20)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamp(6)

  mensagem    Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  denunciante Usuario  @relation(fields: [denuncianteId], references: [id], onDelete: Cascade)

  @@unique([mensagemId, denuncianteId])
  @@index([status], map: "idx_denuncias_status")
  @@map("denuncias")
}
